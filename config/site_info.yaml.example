# 站点配置示例文件

# 站点配置
site:
  name: "Casper Platform"
  version: "1.0.0"
  mode: "debug"              # 运行模式: debug, release, test
  port: 8080                 # 服务端口
  host: "0.0.0.0"           # 监听地址

# 数据库初始化配置
# 使用版本化迁移系统，运行 `./casper_server migrate` 命令进行数据库迁移
database_init:
  auto_migrate: false     # 是否使用GORM自动迁移（已改用版本化迁移系统，设为 false）
  init_default_data: true # 是否初始化默认数据（首次运行后可设为 false）

# JWT 认证配置
jwt:
  secret: "your-secret-key-change-this-in-production-PLEASE-CHANGE-THIS"
  expire_hours: 24           # Token 过期时间（小时）
  refresh_expire_hours: 168  # 刷新令牌过期时间（小时，默认7天）
  issuer: "casper_platform"  # 签发者

# 日志配置
logger:
  level: "info"              # 日志级别: trace, debug, info, warn, error, fatal, panic
  format: "json"             # 日志格式: json, text
  output: "logs/app.log"     # 日志输出路径
  max_size: 100              # 单个日志文件最大大小（MB）
  max_backups: 10            # 保留的旧日志文件数量
  max_age: 30                # 保留日志文件的最大天数
  compress: true             # 是否压缩旧日志

# API 配置
api:
  enable_version: false    # 是否启用版本控制（启用后路径为 /api/v1/...）
  current_version: "v1"    # 当前 API 版本
  rate_limit_enabled: true # 是否启用限流
  rate_limit_requests: 100 # 每分钟最大请求数
  request_id_enabled: true # 是否启用请求ID追踪

# 证书监控配置
certificate:
  check_interval: 3600  # 自动检查间隔（秒，默认1小时）
  warning_days: 30      # 证书到期前多少天开始警告

# 文件上传配置
upload:
  base_dir: "uploads"           # 上传文件根目录
  work_issues_dir: "work-issues" # 工作问题图片子目录
  max_file_size: 5              # 最大文件大小（MB）
  allowed_types: ".jpg,.jpeg,.png,.gif,.webp" # 允许的文件类型

# n8n 工作流引擎配置
n8n:
  api_url: "http://localhost:5678"  # n8n API 地址
  api_key: ""                        # n8n API Key (在 n8n UI 中生成)

# ========================================
# 不同环境的推荐配置
# ========================================

# 开发环境推荐:
# database_init.init_default_data: true
# api.rate_limit_enabled: false
# logger.level: "debug"

