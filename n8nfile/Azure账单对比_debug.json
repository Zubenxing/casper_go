{
  "name": "Azure账单对比(结构优化版)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "azure-bill-upload",
        "responseMode": "responseNode",
        "options": {
          "binaryData": true
        }
      },
      "id": "Webhook_Trigger",
      "name": "接收文件上传",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "operation": "fromFile",
        "binaryPropertyName": "current",
        "fileFormat": "autodetect"
      },
      "id": "Read_Current",
      "name": "读取本月账单",
      "type": "n8n-nodes-base.spreadsheetFile",
      "typeVersion": 2,
      "position": [450, 150]
    },
    {
      "parameters": {
        "operation": "fromFile",
        "binaryPropertyName": "last",
        "fileFormat": "autodetect"
      },
      "id": "Read_Last",
      "name": "读取上月账单",
      "type": "n8n-nodes-base.spreadsheetFile",
      "typeVersion": 2,
      "position": [450, 450]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(i => ({ json: i.json }));"
      },
      "id": "Extract_Current",
      "name": "提取本月数据",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 150]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(i => ({ json: i.json }));"
      },
      "id": "Extract_Last",
      "name": "提取上月数据",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 450]
    },
    {
      "parameters": {
        "jsCode": "const current = $input.all(0).map(i => i.json);\nconst last = $input.all(1).map(i => i.json);\n\nfunction norm(v) { return (v ?? '').toString().trim(); }\nfunction num(v) { if(!v) return 0; return Number(String(v).replace(/,/g,'')) || 0; }\n\nfunction keyOf(r) { return `${norm(r.SubscriptionName)}|${norm(r.ResourceGroup)}|${norm(r.Resource)}`; }\n\nfunction aggregate(list) {\n  const m = new Map();\n  for(const row of list){\n    const key = keyOf(row);\n    const cost = num(row.Cost || row.CostUSD || row.PreTaxCost);\n    const prev = m.get(key) || { row, cost:0 };\n    prev.cost += cost;\n    m.set(key, prev);\n  }\n  return m;\n}\n\nconst curMap = aggregate(current);\nconst lastMap = aggregate(last);\n\nconst keys = new Set([...curMap.keys(), ...lastMap.keys()]);\nconst result = [];\n\nfor(const key of keys){\n  const cur = curMap.get(key);\n  const las = lastMap.get(key);\n  const base = (cur ? cur.row : las.row);\n\n  const curCost = cur ? cur.cost : 0;\n  const lastCost = las ? las.cost : 0;\n  const delta = curCost - lastCost;\n\n  result.push({\n    Resource: norm(base.Resource),\n    SubscriptionName: norm(base.SubscriptionName),\n    ResourceGroup: norm(base.ResourceGroup),\n    CurrentCost: curCost,\n    LastCost: lastCost,\n    Delta: delta,\n    Change: !las ? \"NEW\" : !cur ? \"REMOVED\" : delta === 0 ? \"SAME\" : delta > 0 ? \"UP\" : \"DOWN\"\n  });\n}\n\nreturn result.map(r => ({ json: r }));"
      },
      "id": "Compare",
      "name": "对比分析",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [950, 300]
    },
    {
      "parameters": {
        "operation": "toFile",
        "fileFormat": "csv",
        "options": { "fileName": "azure-bill-comparison.csv" }
      },
      "id": "Export",
      "name": "生成CSV",
      "type": "n8n-nodes-base.spreadsheetFile",
      "typeVersion": 2,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "respondWith": "binary",
        "binaryPropertyName": "data"
      },
      "id": "Respond",
      "name": "返回",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1450, 300]
    }
  ],
  "connections": {
    "接收文件上传": {
      "main": [
        [
          { "node": "读取本月账单", "type": "main", "index": 0 },
          { "node": "读取上月账单", "type": "main", "index": 0 }
        ]
      ]
    },
    "读取本月账单": {
      "main": [
        [
          { "node": "提取本月数据", "type": "main", "index": 0 }
        ]
      ]
    },
    "读取上月账单": {
      "main": [
        [
          { "node": "提取上月数据", "type": "main", "index": 0 }
        ]
      ]
    },
    "提取本月数据": {
      "main": [
        [
          { "node": "对比分析", "type": "main", "index": 0 }
        ]
      ]
    },
    "提取上月数据": {
      "main": [
        [
          { "node": "对比分析", "type": "main", "index": 1 }
        ]
      ]
    },
    "对比分析": {
      "main": [
        [
          { "node": "生成CSV", "type": "main", "index": 0 }
        ]
      ]
    },
    "生成CSV": {
      "main": [
        [
          { "node": "返回", "type": "main", "index": 0 }
        ]
      ]
    }
  }
}
